{
  "name": "pear-vanity-gpu",
  "version": "0.1.0",
  "description": "CPU, Vulkan, OpenCL and HIP vanity searches for Hypercore keys on Bare",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./vulkan": "./lib/vulkan.js",
    "./opencl": "./lib/opencl.js",
    "./hip": "./lib/hip.js"
  },
  "files": [
    "index.js",
    "binding.js",
    "binding.cc",
    "CMakeLists.txt",
    "lib",
    "native",
    "prebuilds",
    "scripts",
    "LICENSE",
    "NOTICE",
    "README.md",
    ".clang-format"
  ],
  "scripts": {
    "test": "bare test/vanity.test.js",
    "build": "cmake -S . -B out/addon -DCMAKE_BUILD_TYPE=Release && cmake --build out/addon --config Release",
    "prebuild": "npm run build && cmake --install out/addon --prefix prebuilds && bare scripts/configure-prebuilds.js",
    "benchmark": "bare scripts/benchmark.js",
    "lint": "npm run lint:js && npm run lint:native",
    "format": "prettier --write . && lunte --fix && npm run format:native",
    "lint:js": "prettier --check . && lunte",
    "lint:native": "clang-format --dry-run --Werror binding.cc native/*.h native/search.comp test/native.cc",
    "format:native": "clang-format -i binding.cc native/*.h native/search.comp test/native.cc",
    "pack": "bare scripts/configure-prebuilds.js && npm pack",
    "test:native": "cmake -S . -B out/addon -DVANITY_TESTS=ON && cmake --build out/addon --config Release && ctest --test-dir out/addon --output-on-failure"
  },
  "dependencies": {
    "bare-os": "^3.9.3",
    "bare-worker": "^4.4.0",
    "hyper-multisig": "^2.0.0",
    "hypercore": "^11.33.5",
    "hypercore-crypto": "^3.5.0",
    "hypercore-id-encoding": "^1.3.0",
    "pear-gracedown": "^1.0.4",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "bare-fs": "^4.7.4",
    "bare-make": "^2.0.1",
    "bare-runtime": "^1.36.0",
    "brittle": "^4.0.0",
    "cmake-bare": "^1.10.0",
    "lunte": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "license": "Apache-2.0",
  "addon": true,
  "engines": {
    "bare": ">=1.36.0"
  },
  "imports": {
    "#binding": {
      "linux": {
        "x64": "./binding.js",
        "default": "./lib/unsupported.js"
      },
      "default": "./lib/unsupported.js"
    }
  },
  "author": "Jan Keith Darunday <jkcdarunday@gmail.com>"
}
