// Original ChaCha20: fresh 256-bit search key, zero nonce, 64-bit block counter.
// SHA-512 follows FIPS 180-4; CPU samples use libsodium independently.
uint rotate32(uint x, uint n) { return (x << n) | (x >> (32 - n)); }

void quarter(inout uint x[16], int a, int b, int c, int d) {
  x[a] += x[b];
  x[d] = rotate32(x[d] ^ x[a], 16);
  x[c] += x[d];
  x[b] = rotate32(x[b] ^ x[c], 12);
  x[a] += x[b];
  x[d] = rotate32(x[d] ^ x[a], 8);
  x[c] += x[d];
  x[b] = rotate32(x[b] ^ x[c], 7);
}

uint swap32(uint x) {
  return (x << 24) | ((x & 0xff00) << 8) | ((x >> 8) & 0xff00) | (x >> 24);
}

uint64_t rotateSHA(uint64_t x, uint n) { return (x >> n) | (x << (64 - n)); }

