uint64_t rotate64(uint64_t x, uint n) { return (x >> n) | (x << (64 - n)); }

void mix(inout uint64_t v[16], int a, int b, int c, int d, uint64_t x, uint64_t y) {
  v[a] += v[b] + x;
  v[d] = rotate64(v[d] ^ v[a], 32);
  v[c] += v[d];
  v[b] = rotate64(v[b] ^ v[c], 24);
  v[a] += v[b] + y;
  v[d] = rotate64(v[d] ^ v[a], 16);
  v[c] += v[d];
  v[b] = rotate64(v[b] ^ v[c], 63);
}

// Stream bytes directly from the template, patching a public key or namespace
// digest.
uint inputByte(uint pos, bool ns, uint replacement[8], uint64_t counter) {
  if (ns) {
    if (pos < p.namespaceLen)
      return cfg[4096 + pos];

    uint nibble = uint(counter >> ((15 - (pos - p.namespaceLen)) * 4)) & 15;
    return nibble < 10 ? 48 + nibble : 97 + nibble - 10;
  }

  // A byte-to-patch lookup avoids scanning every signer for each input byte.
  uint tag = cfg[6260 + pos];
  if (tag == 0)
    return cfg[pos];

  uint byte = tag - 1;
  return (replacement[byte / 4] >> ((byte % 4) * 8)) & 255;
}

void hashBytes(bool ns, uint replacement[8], uint64_t counter, out uint digest[8]) {
  uint len = ns ? p.namespaceLen + 16 : p.templateLen;
  uint64_t h[8];
  for (int i = 0; i < 8; i++)
    h[i] = IV[i];
  h[0] ^= 0x01010020ul;

  for (uint off = 0; off < len; off += 128) {
    uint64_t m[16];
    for (int i = 0; i < 16; i++)
      m[i] = 0;

    uint used = min(128, len - off);
    for (uint i = 0; i < used; i++)
      m[i / 8] |= uint64_t(inputByte(off + i, ns, replacement, counter)) << ((i % 8) * 8);

    uint64_t v[16];
    for (int i = 0; i < 8; i++) {
      v[i] = h[i];
      v[i + 8] = IV[i];
    }

    v[12] ^= uint64_t(off + used);
    if (off + used == len)
      v[14] = ~v[14];

    for (int r = 0; r < 12; r++) {
      int s = r * 16;
      mix(v, 0, 4, 8, 12, m[SIGMA[s]], m[SIGMA[s + 1]]);
      mix(v, 1, 5, 9, 13, m[SIGMA[s + 2]], m[SIGMA[s + 3]]);
      mix(v, 2, 6, 10, 14, m[SIGMA[s + 4]], m[SIGMA[s + 5]]);
      mix(v, 3, 7, 11, 15, m[SIGMA[s + 6]], m[SIGMA[s + 7]]);
      mix(v, 0, 5, 10, 15, m[SIGMA[s + 8]], m[SIGMA[s + 9]]);
      mix(v, 1, 6, 11, 12, m[SIGMA[s + 10]], m[SIGMA[s + 11]]);
      mix(v, 2, 7, 8, 13, m[SIGMA[s + 12]], m[SIGMA[s + 13]]);
      mix(v, 3, 4, 9, 14, m[SIGMA[s + 14]], m[SIGMA[s + 15]]);
    }

    for (int i = 0; i < 8; i++)
      h[i] ^= v[i] ^ v[i + 8];
  }

  for (uint i = 0; i < 8; i++)
    digest[i] = uint(h[i / 2] >> ((i % 2) * 32));
}

void storeResult(uint slot, uint replacement[8], uint digest[8]) {
  for (uint i = 0; i < 8; i++) {
    results[slot * 16 + i] = replacement[i];
    results[slot * 16 + 8 + i] = digest[i];
  }
}

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= p.count)
    return;

  uint replacement[8], digest[8];
  for (int i = 0; i < 8; i++)
    replacement[i] = 0;

  uint64_t counter = (uint64_t(p.counterHigh) << 32) + p.counterLow + id;

#if TOUCH
  uint scalar[8];
  candidateScalar(counter, scalar);
  publicKey(scalar, replacement);
#else
  {
    uint unused[8] = replacement;
    hashBytes(true, unused, counter, replacement);
  }
#endif

  hashBytes(false, replacement, counter, digest);

  if (p.diagnosticCount != 0) {
    // Spread eight samples across the dispatch, including its final active
    // lane.
    uint slot = min(7, (id * 7 + p.count - 2) / (p.count - 1));
    if (slot * (p.count - 1) / 7 == id)
      storeResult(slot, replacement, digest);
  }

  // Prefix masks compare packed hash words directly, avoiding z32 encoding
  // and byte arrays in every invocation. Only the prefix's words are examined.
  uint words = min(8, (p.targetLen * 5 + 31) / 32);
  for (uint i = 0; i < words; i++)
    if (((digest[i] ^ cfg[6216 + i]) & cfg[6208 + i]) != 0)
      return;

  // Only the first matching lane claims the single result slot. This avoids
  // both full-batch readback and races between an index and its crypto output.
  if (atomicCompSwap(winner, 0xffffffffu, id) == 0xffffffffu)
    storeResult(8, replacement, digest);
}
