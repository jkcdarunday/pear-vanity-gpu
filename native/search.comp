// Point formulas follow TweetNaCl; fields use the ref10 radix-2^25.5.
// https://tweetnacl.cr.yp.to/ (20140427)
layout(local_size_x = 64) in;

layout(binding = 0, std430) readonly buffer Config { uint cfg[]; };

layout(binding = 1, std430) readonly buffer Table { uint table[]; };

layout(binding = 2, std430) buffer Results {
  uint winner;
  uint results[];
};

layout(push_constant) uniform Parameters {
  uint mode, count, templateLen, namespaceLen, offsetCount, targetLen, counterLow,
      counterHigh, diagnosticCount;
}

