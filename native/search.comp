void candidateScalar(uint64_t counter, out uint scalar[8]) {
  uint initial[16] =
      uint[](0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, cfg[6224], cfg[6225],
             cfg[6226], cfg[6227], cfg[6228], cfg[6229], cfg[6230], cfg[6231],
             uint(counter), uint(counter >> 32), 0, 0);
  uint x[16] = initial;

  for (int i = 0; i < 10; i++) {
    quarter(x, 0, 4, 8, 12);
    quarter(x, 1, 5, 9, 13);
    quarter(x, 2, 6, 10, 14);
    quarter(x, 3, 7, 11, 15);
    quarter(x, 0, 5, 10, 15);
    quarter(x, 1, 6, 11, 12);
    quarter(x, 2, 7, 8, 13);
    quarter(x, 3, 4, 9, 14);
  }

  uint64_t w[16];
  for (int i = 0; i < 4; i++) {
    w[i] = (uint64_t(swap32(x[2 * i] + initial[2 * i])) << 32) |
           uint64_t(swap32(x[2 * i + 1] + initial[2 * i + 1]));
  }
  w[4] = 0x8000000000000000ul;
  for (int i = 5; i < 15; i++)
    w[i] = 0;
  w[15] = 256;

  uint64_t a = SHA_INITIAL[0], b = SHA_INITIAL[1], c = SHA_INITIAL[2], d = SHA_INITIAL[3];
  uint64_t e = SHA_INITIAL[4], f = SHA_INITIAL[5], g = SHA_INITIAL[6], h = SHA_INITIAL[7];

  for (int i = 0; i < 80; i++) {
    if (i >= 16) {
      uint64_t u = w[(i + 1) & 15], v = w[(i + 14) & 15];
      w[i & 15] += (rotateSHA(u, 1) ^ rotateSHA(u, 8) ^ (u >> 7)) + w[(i + 9) & 15] +
                   (rotateSHA(v, 19) ^ rotateSHA(v, 61) ^ (v >> 6));
    }
    uint64_t first = h + (rotateSHA(e, 14) ^ rotateSHA(e, 18) ^ rotateSHA(e, 41)) +
                     ((e & f) ^ (~e & g)) + SHA_K[i] + w[i & 15];
    uint64_t second = (rotateSHA(a, 28) ^ rotateSHA(a, 34) ^ rotateSHA(a, 39)) +
                      ((a & b) ^ (a & c) ^ (b & c));
    h = g;
    g = f;
    f = e;
    e = d + first;
    d = c;
    c = b;
    b = a;
    a = first + second;
  }

  uint64_t digest[4] = uint64_t[](a + SHA_INITIAL[0], b + SHA_INITIAL[1],
                                  c + SHA_INITIAL[2], d + SHA_INITIAL[3]);
  for (int i = 0; i < 4; i++) {
    scalar[2 * i] = swap32(uint(digest[i] >> 32));
    scalar[2 * i + 1] = swap32(uint(digest[i]));
  }
  scalar[0] &= 0xfffffff8;
  scalar[7] = (scalar[7] & 0x7fffffff) | 0x40000000;
}

struct Field {
  int v[10];
};

struct Point {
  Field x, y, z, t;
};

Field zero() {
  Field a;
  for (int i = 0; i < 10; i++)
    a.v[i] = 0;

  return a;
}

Field one() {
  Field a = zero();
  a.v[0] = 1;

  return a;
}

Field plus(Field a, Field b) {
  for (int i = 0; i < 10; i++)
    a.v[i] += b.v[i];

  return a;
}

Field minus(Field a, Field b) {
  for (int i = 0; i < 10; i++)
    a.v[i] -= b.v[i];

  return a;
}

Field carry(Field a) {
  for (int i = 0; i < 10; i++) {
    int bits = i % 2 == 0 ? 26 : 25;
    a.v[i] += 1 << bits;
    int c = a.v[i] >> bits;

    if (i < 9)
      a.v[i + 1] += c - 1;
    else
      a.v[0] += 19 * (c - 1);

    a.v[i] -= c * (1 << bits);
  }

  return a;
}

// Generated straight-line 32x32 products with 64-bit accumulators and a
// symmetric square. No dynamically indexed convolution scratch arrays.
#include "field.glsl"

Field squares(Field a, int count) {
  for (int i = 0; i < count; i++)
    a = square(a);

  return a;
}

// z^(2^255-21): 254 squarings and 11 multiplications, versus 252 multiplies
// in the binary exponentiation path. The intermediate exponents are 2^n-1.
Field inverse(Field z) {
  Field z2 = square(z);
  Field z9 = mul(squares(z2, 2), z);
  Field z11 = mul(z9, z2);
  Field z5 = mul(square(z11), z9);
  Field z10 = mul(squares(z5, 5), z5);
  Field z20 = mul(squares(z10, 10), z10);
  Field z40 = mul(squares(z20, 20), z20);
  Field z50 = mul(squares(z40, 10), z10);
  Field z100 = mul(squares(z50, 50), z50);
  Field z200 = mul(squares(z100, 100), z100);
  Field z250 = mul(squares(z200, 50), z50);

  return mul(squares(z250, 5), z11);
}

Field canonical(Field a) {
  a = carry(carry(carry(a)));

  for (int j = 0; j < 2; j++) {
    Field m = a;
    m.v[0] -= 0x3ffffed;

    for (int i = 1; i < 10; i++) {
      int previousBits = i % 2 == 0 ? 25 : 26;
      int bits = i % 2 == 0 ? 26 : 25;
      m.v[i] -= ((1 << bits) - 1) + ((m.v[i - 1] >> previousBits) & 1);
      m.v[i - 1] &= (1 << previousBits) - 1;
    }

    if (((m.v[9] >> 25) & 1) == 0)
      a = m;
  }

  return a;
}

Point identity() { return Point(zero(), one(), one(), zero()); }

// Affine cached-point addition needs seven field multiplications; the old
// extended-point path needed nine. The cached table folds in the curve
// constant.
Field tableField(uint window, uint coordinate, uint digit) {
  Field value;
  for (uint limb = 0; limb < 10; limb++)
    value.v[limb] = int(table[((window * 3 + coordinate) * 10 + limb) * 129 + digit]);
  return value;
}

Point addCached(Point p1, uint window, int digit) {
  uint magnitude = uint(abs(digit));
  Field ymx = tableField(window, digit < 0 ? 1 : 0, magnitude);
  Field ypx = tableField(window, digit < 0 ? 0 : 1, magnitude);
  Field xy2d = tableField(window, 2, magnitude);
  if (digit < 0)
    xy2d = minus(zero(), xy2d);
  Field a = mul(minus(p1.y, p1.x), ymx);
  Field b = mul(plus(p1.x, p1.y), ypx);
  Field c = mul(p1.t, xy2d);
  Field dd = plus(p1.z, p1.z);
  Field e = minus(b, a), f = minus(dd, c), g = plus(dd, c), h = plus(b, a);

  return Point(mul(e, f), mul(h, g), mul(g, f), mul(e, h));
}

void publicKey(uint scalar[8], out uint pk[8]) {
  Point q = identity();
  int carryDigit = 0;

  for (uint w = 0; w < 32; w++) {
    int digit = int((scalar[w / 4] >> ((w % 4) * 8)) & 255) + carryDigit;
    carryDigit = (digit + 128) >> 8;
    if (w < 31)
      digit -= carryDigit * 256;
    q = addCached(q, w, digit);
  }

  Field iz = inverse(q.z), x = canonical(mul(q.x, iz)), y = canonical(mul(q.y, iz));
  pack(y, pk);

  pk[7] ^= uint(x.v[0] & 1) << 31;
}

